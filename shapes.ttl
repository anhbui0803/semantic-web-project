@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix fb:   <http://localhost:5000/ontology#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix fbsh: <http://localhost:5000/shapes#> .

# =====================================================================
#  SHACL shapes: closed-world data-quality rules for the published data
#  (OWL describes meaning, SHACL checks that every record is complete).
#  Run:  python build.py --check
# =====================================================================

fbsh:ClubShape a sh:NodeShape ;
    sh:targetClass fb:Club ;
    sh:property [ sh:path fb:name ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path fb:country ; sh:minCount 1 ; sh:maxCount 1 ; sh:class fb:Country ] ;
    sh:property [ sh:path [ sh:inversePath fb:participant ] ; sh:minCount 1 ; sh:class fb:Season ] ;
    sh:property [ sh:path owl:sameAs ; sh:minCount 1 ; sh:nodeKind sh:IRI ;
                  sh:pattern "^http://dbpedia\\.org/resource/|^http://www\\.wikidata\\.org/entity/" ;
                  sh:message "Every club must be linked to DBpedia/Wikidata (5-star)" ] .

fbsh:MatchShape a sh:NodeShape ;
    sh:targetClass fb:Match ;
    sh:property [ sh:path fb:inSeason ; sh:minCount 1 ; sh:maxCount 1 ; sh:class fb:Season ] ;
    sh:property [ sh:path fb:homeTeam ; sh:minCount 1 ; sh:maxCount 1 ; sh:class fb:Club ] ;
    sh:property [ sh:path fb:awayTeam ; sh:minCount 1 ; sh:maxCount 1 ; sh:class fb:Club ;
                  sh:disjoint fb:homeTeam ; sh:message "A club cannot play against itself" ] ;
    sh:property [ sh:path fb:kickOff ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ;
                  sh:minInclusive "2023-07-01T00:00:00"^^xsd:dateTime ;
                  sh:maxInclusive "2024-06-30T23:59:59"^^xsd:dateTime ] ;
    sh:property [ sh:path fb:round ; sh:minCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 38 ] ;
    sh:property [ sh:path fb:homeScore ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:nonNegativeInteger ] ;
    sh:property [ sh:path fb:awayScore ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:nonNegativeInteger ] ;
    sh:property [ sh:path fb:homeHalfTimeScore ; sh:maxCount 1 ; sh:datatype xsd:nonNegativeInteger ] ;
    sh:property [ sh:path fb:awayHalfTimeScore ; sh:maxCount 1 ; sh:datatype xsd:nonNegativeInteger ] ;
    sh:property [ sh:path fb:result ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( fb:HomeWin fb:Draw fb:AwayWin ) ] ;
    sh:property [ sh:path fb:winner ; sh:maxCount 1 ; sh:class fb:Club ] .

fbsh:StandingShape a sh:NodeShape ;
    sh:targetClass fb:Standing ;
    sh:property [ sh:path fb:team ; sh:minCount 1 ; sh:maxCount 1 ; sh:class fb:Club ] ;
    sh:property [ sh:path fb:inSeason ; sh:minCount 1 ; sh:maxCount 1 ; sh:class fb:Season ] ;
    sh:property [ sh:path fb:rank ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:positiveInteger ] ;
    sh:property [ sh:path fb:points ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:nonNegativeInteger ] ;
    sh:sparql [ sh:message "won + drawn + lost must equal played, points = 3*won + drawn, GD = GF - GA" ;
        sh:select """PREFIX fb: <http://localhost:5000/ontology#>
                     SELECT $this WHERE { $this fb:played ?p ; fb:won ?w ; fb:drawn ?d ; fb:lost ?l ;
                       fb:points ?pts ; fb:goalsFor ?gf ; fb:goalsAgainst ?ga ; fb:goalDifference ?gd .
                       FILTER(?w + ?d + ?l != ?p || 3 * ?w + ?d != ?pts || ?gf - ?ga != ?gd) }""" ] .

fbsh:SeasonShape a sh:NodeShape ;
    sh:targetClass fb:Season ;
    sh:property [ sh:path fb:ofLeague ; sh:minCount 1 ; sh:maxCount 1 ; sh:class fb:League ] ;
    sh:property [ sh:path fb:champion ; sh:minCount 1 ; sh:maxCount 1 ; sh:class fb:Club ] ;
    sh:property [ sh:path fb:participant ; sh:minCount 18 ; sh:maxCount 20 ] ;
    # Match-level business rules, evaluated once per season (?value = offending match) for speed
    sh:sparql [ sh:message "Half-time score cannot exceed full-time score" ;
        sh:select """PREFIX fb: <http://localhost:5000/ontology#>
                     SELECT $this ?value WHERE { ?value fb:inSeason $this ; fb:homeScore ?h ; fb:awayScore ?a ;
                       fb:homeHalfTimeScore ?hh ; fb:awayHalfTimeScore ?ah .
                       FILTER(?hh > ?h || ?ah > ?a) }""" ] ;
    sh:sparql [ sh:message "fb:result / fb:winner must agree with the score" ;
        sh:select """PREFIX fb: <http://localhost:5000/ontology#>
                     SELECT $this ?value WHERE { ?value fb:inSeason $this ; fb:homeScore ?h ; fb:awayScore ?a ;
                       fb:result ?r ; fb:homeTeam ?ht ; fb:awayTeam ?at .
                       OPTIONAL { ?value fb:winner ?w }
                       FILTER(  (?h > ?a && (?r != fb:HomeWin || !BOUND(?w) || ?w != ?ht))
                             || (?h < ?a && (?r != fb:AwayWin || !BOUND(?w) || ?w != ?at))
                             || (?h = ?a && (?r != fb:Draw || BOUND(?w)))) }""" ] ;
    sh:sparql [ sh:message "Double round-robin: each club must play 2 x (n - 1) matches" ;
        sh:select """PREFIX fb: <http://localhost:5000/ontology#>
                     SELECT $this WHERE {
                       { SELECT $this (COUNT(DISTINCT ?c) AS ?n) WHERE { $this fb:participant ?c } GROUP BY $this }
                       $this fb:participant ?club .
                       { SELECT $this ?club (COUNT(?m) AS ?games) WHERE {
                           ?m fb:inSeason $this . { ?m fb:homeTeam ?club } UNION { ?m fb:awayTeam ?club } }
                         GROUP BY $this ?club }
                       FILTER(?games != 2 * (?n - 1)) }""" ] .

fbsh:LeagueShape a sh:NodeShape ;
    sh:targetClass fb:League , fb:Country ;
    sh:property [ sh:path fb:name ; sh:minCount 1 ] ;
    sh:property [ sh:path owl:sameAs ; sh:minCount 2 ; sh:nodeKind sh:IRI ] .
